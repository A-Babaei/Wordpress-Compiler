# Copy to .env and fill in real values. Never commit the real .env file.

# Shared secret used to verify JWTs issued by your main site.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_AUDIENCE=academy-tech-compiler

# Comma-separated list of origins allowed to call the API from a browser.
ALLOWED_ORIGINS=https://academy-tech.ir

# Dev-only: skip JWT auth entirely. NEVER set this to true in production.
ALLOW_ANONYMOUS=false

RUN_TIMEOUT_SECONDS=8
MAX_OUTPUT_BYTES=65536
MAX_CODE_LENGTH=20000
RATE_LIMIT_PER_MINUTE=10

SANDBOX_IMAGE=academy-tech-compiler-sandbox:latest
SANDBOX_MEM_LIMIT=128m
SANDBOX_NANO_CPUS=500000000
SANDBOX_PIDS_LIMIT=64
